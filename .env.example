# Porta HTTP do servidor (Railway injeta automaticamente PORT)
PORT=3000

# Caminho do Volume Persistente no Railway (ex: /data). Se omitido, usa ./data localmente.
RAILWAY_VOLUME_MOUNT_PATH=

# Provedor HTTP gratuito para envio do código de verificação OTP por e-mail
# Opções suportadas: resend | brevo
EMAIL_PROVIDER=resend

# Chave de API do provedor escolhido (Resend ou Brevo).
# Se omitida em desenvolvimento, o código OTP de 6 dígitos é registrado no console do servidor (fallback de teste).
EMAIL_API_KEY=

# Remetente exibido nos e-mails de verificação
EMAIL_FROM="e-SAM <onboarding@resend.dev>"
